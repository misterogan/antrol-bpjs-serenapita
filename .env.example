APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ---- Modul Antrean Online (config/antrol.php) ----
ANTROL_NAMA_RS="RSU SERENAPITA"
ANTROL_LOGO=img/logo-rs.png
ANTROL_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/antreanrs_dev
ANTROL_CONS_ID=
ANTROL_SECRET_KEY=
ANTROL_USER_KEY=
ANTROL_TIMEOUT=30
ANTROL_MODE_SIMULASI=false
# Alat simulasi (Pendaftaran simulasi, Poli simulasi, Data uji). false = disembunyikan, route 404, mode simulasi diabaikan.
ANTROL_TAMPILKAN_ALAT_SIMULASI=false
ANTROL_MENIT_PER_PASIEN=6
ANTROL_KETERANGAN_FARMASI="Antrean farmasi diambil di rumah sakit"
ANTROL_PESAN_FINGERPRINT=
ANTROL_CACHE_POLI_FP=60
# Sumber data antrean farmasi: lokal (data uji) | bpjs (BPJS + resep dari SIMRS vendor)
ANTROL_SUMBER_DATA=lokal
ANTROL_CEK_BPJS_CACHE_MENIT=2
ANTROL_KIRIM_TASK_FARMASI=true
ANTROL_JEDA_SINKRON_MS=100
ANTROL_BATAS_GAGAL_KONEKSI=5
# WSRS untuk BPJS (/jkn/...)
ANTROL_WSRS_USERNAME=
ANTROL_WSRS_PASSWORD=
ANTROL_WSRS_TOKEN_TTL=60
ANTROL_WSRS_PREFIX=jkn
ANTROL_WSRS_PATH_AUTH=auth
ANTROL_WSRS_PATH_AMBIL_FARMASI=ambil-antrean-farmasi
ANTROL_WSRS_PATH_STATUS_FARMASI=status-antrean-farmasi
ANTROL_WSRS_TOKEN_MODE=lokal
# Penyedia WSRS ambil/status antrean farmasi: vendor (BPJS memanggil SIMRS vendor; route lokal 404) | lokal
ANTROL_WSRS_PROVIDER=vendor
# Sumber nomor antrean farmasi onsite: vendor (Ambil Antrean Farmasi SIMRS vendor) | lokal
ANTROL_NOMOR_FARMASI_DARI=vendor
ANTROL_VENDOR_BASE_URL=
ANTROL_VENDOR_TIMEOUT=5
ANTROL_VENDOR_TOKEN_CACHE_MENIT=2
# Klien WSRS vendor (ambil & status antrean farmasi)
ANTROL_VENDOR_USERNAME=
ANTROL_VENDOR_PASSWORD=
ANTROL_VENDOR_PATH_AUTH=/jkn/auth
ANTROL_VENDOR_PATH_AMBIL_FARMASI=/jkn/ambil-antrean-farmasi
ANTROL_VENDOR_PATH_STATUS_FARMASI=/jkn/status-antrean-farmasi
ANTROL_VENDOR_WSRS_TIMEOUT=10
ANTROL_VENDOR_TOKEN_CACHE_TANPA_EXP=5
# API internal untuk SIMRS vendor (/jkn/internal/*). Kosong = semua request ditolak.
ANTROL_INTERNAL_API_KEY=
ANTROL_INTERNAL_IP_ALLOWLIST=
ANTROL_INTERNAL_PER_MENIT=120
